{
  "name": "neodraw",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:http": "turbo dev --filter=@repo/http-backend",
    "dev:ws": "turbo dev --filter=@repo/ws-backend",
    "dev:frontend": "turbo dev --filter=@repo/neodraw-frontend",
    "build": "turbo build",
    "start": "node ./scripts/start.mjs",
    "build:http": "turbo build --filter=@repo/http-backend",
    "build:ws": "turbo build --filter=@repo/ws-backend",
    "build:frontend": "turbo build --filter=@repo/neodraw-frontend",
    "test": "turbo test",
    "test:unit": "pnpm --filter ny-tests test:unit",
    "test:integration": "pnpm --filter ny-tests test:integration",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo check-types"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.0"
}
