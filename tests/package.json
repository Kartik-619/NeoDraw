{
  "name": "ny-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --dir unit",
    "test:integration": "vitest run --dir integration",
    "test:ws": "vitest run --dir ws",
    "test:load": "vitest run --dir load",
    "test:security": "vitest run --dir security",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@repo/shared-types": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/common": "workspace:*",
    "@repo/backend-common": "workspace:*",
    "@repo/http-backend": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "jsdom": "^26.0.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  }
}